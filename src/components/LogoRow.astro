---
import { getCompanyLogo } from '@components/CompanyLogo.astro';

const logos = [
  { name: 'Areim', src: getCompanyLogo('areim'), height: 'h-8' },
  { name: 'Avant', src: getCompanyLogo('avant'), height: 'h-8' },
  { name: 'Catella', src: getCompanyLogo('catella'), height: 'h-12' },
  { name: 'Conficap', src: getCompanyLogo('conficap'), height: 'h-8' },
  { name: 'Lifeline', src: getCompanyLogo('lifeline'), height: 'h-10' },
  { name: 'LähiTapiola', src: getCompanyLogo('lähitapiola'), height: 'h-8' },
  { name: 'Patria', src: getCompanyLogo('patria'), height: 'h-5.5' },
  { name: 'Skanska', src: getCompanyLogo('skanska'), height: 'h-5' },
  { name: 'SRV', src: getCompanyLogo('srv'), height: 'h-6' },
  { name: 'Varte', src: getCompanyLogo('varte'), height: 'h-8' }
];
---

<div class="group relative flex w-full flex-nowrap gap-24 overflow-hidden mask-x-from-80% py-4">
  <ul
    class="animate-loop-scroll flex items-center gap-24 group-hover:[animation-play-state:paused]"
  >
    {
      logos.map(({ name, src: Logo, height }) => (
        <li aria-label={name}>
          <Logo class={`w-auto shrink-0 text-neutral-950 dark:text-neutral-50 ${height}`} />
        </li>
      ))
    }
  </ul>
  <ul
    class="animate-loop-scroll flex items-center gap-24 group-hover:[animation-play-state:paused]"
    aria-hidden="true"
  >
    {
      logos.map(({ name, src: Logo, height }) => (
        <li aria-label={name}>
          <Logo class={`w-auto shrink-0 text-neutral-950 dark:text-neutral-50 ${height}`} />
        </li>
      ))
    }
  </ul>
</div>
